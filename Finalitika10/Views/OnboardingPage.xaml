<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Finalitika10.ViewModels"
             xmlns:converters="clr-namespace:Finalitika10.Converters"
             x:Class="Finalitika10.Views.OnboardingPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IntToVisibleConverter x:Key="IntToVisibleConverter" />
            <converters:StepToColorConverter x:Key="StepToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8FAFC" Offset="0.0" />
            <GradientStop Color="#E2E8F0" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="*, Auto" Padding="20,40,20,20">

        <Grid Grid.Row="0" VerticalOptions="Center">

            <VerticalStackLayout Spacing="25" IsVisible="{Binding CurrentStep, Converter={StaticResource IntToVisibleConverter}, ConverterParameter=0}">
                <Image Source="dotnet_bot.png" HeightRequest="100" HorizontalOptions="Center" Margin="0,0,0,10"/>
                <Label Text="Финалитика" FontSize="32" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#1E293B"/>
                <Label Text="Настройте приложение под себя за 1 минуту" FontSize="16" HorizontalTextAlignment="Center" TextColor="#64748B" Margin="0,-15,0,15"/>

                <Border Padding="15" BackgroundColor="White" Stroke="Transparent" Margin="0,5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                        <Border BackgroundColor="#E0F2FE" WidthRequest="40" HeightRequest="40" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="📄" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Документы и чеки" FontAttributes="Bold" TextColor="#1E293B" FontSize="15"/>
                            <Label Text="Налоговые вычеты и справки" TextColor="#64748B" FontSize="12"/>
                        </VerticalStackLayout>
                        <CheckBox Grid.Column="2" IsChecked="{Binding UseDocuments}" Color="#0EA5E9" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <Border Padding="15" BackgroundColor="White" Stroke="Transparent" Margin="0,5">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                        <Border BackgroundColor="#DCFCE7" WidthRequest="40" HeightRequest="40" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="📈" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Инвестиции" FontAttributes="Bold" TextColor="#1E293B" FontSize="15"/>
                            <Label Text="Синхронизация с Тинькофф" TextColor="#64748B" FontSize="12"/>
                        </VerticalStackLayout>
                        <CheckBox Grid.Column="2" IsChecked="{Binding UseInvestments}" Color="#10B981" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <Button Text="Начать" Command="{Binding NextStepCommand}" BackgroundColor="#0EA5E9" TextColor="White" FontAttributes="Bold" CornerRadius="14" HeightRequest="56" Margin="0,20,0,0"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="20" IsVisible="{Binding CurrentStep, Converter={StaticResource IntToVisibleConverter}, ConverterParameter=1}">
                <Label Text="Ваш профиль" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#1E293B"/>
                <Label Text="Эти данные нужны для автозаполнения документов" FontSize="14" HorizontalTextAlignment="Center" TextColor="#64748B" Margin="0,-10,0,10"/>

                <Border Padding="15,5" BackgroundColor="White" Stroke="#CBD5E1">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Entry Text="{Binding UserFio}" Placeholder="Иванов Иван Иванович" TextColor="#1E293B" PlaceholderColor="#94A3B8" BackgroundColor="Transparent"/>
                </Border>

                <VerticalStackLayout IsVisible="{Binding UseInvestments}" Spacing="10" Margin="0,15,0,0">
                    <Label Text="Tinkoff Invest API (Только чтение)" FontSize="14" FontAttributes="Bold" TextColor="#1E293B"/>
                    <Border Padding="15,5" BackgroundColor="White" Stroke="#CBD5E1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding TinkoffToken}" Placeholder="t.xxxxxxxx..." IsPassword="True" TextColor="#1E293B" PlaceholderColor="#94A3B8" BackgroundColor="Transparent"/>
                    </Border>
                    <Label Text="Ключ хранится исключительно на вашем устройстве в SecureStorage." FontSize="11" TextColor="#94A3B8"/>
                </VerticalStackLayout>

                <Button Text="Продолжить" Command="{Binding NextStepCommand}" BackgroundColor="#0EA5E9" TextColor="White" FontAttributes="Bold" CornerRadius="14" HeightRequest="56" Margin="0,20,0,0"/>
                <Button Text="Назад" Command="{Binding PreviousStepCommand}" BackgroundColor="Transparent" TextColor="#64748B" FontAttributes="Bold"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="20" IsVisible="{Binding CurrentStep, Converter={StaticResource IntToVisibleConverter}, ConverterParameter=2}">
                <Label Text="Безопасность" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#1E293B"/>
                <Label Text="Защитите свои финансы от посторонних глаз" FontSize="14" HorizontalTextAlignment="Center" TextColor="#64748B" Margin="0,-10,0,10"/>

                <Border Padding="20" BackgroundColor="White" Stroke="Transparent">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Вход по ПИН-коду" FontAttributes="Bold" TextColor="#1E293B" FontSize="16"/>
                            <Label Text="Требовать код при запуске" TextColor="#64748B" FontSize="13"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding UsePin}" OnColor="#0EA5E9"/>
                    </Grid>
                </Border>

                <VerticalStackLayout IsVisible="{Binding UsePin}" Spacing="15" Margin="0,20,0,0">
                    <Label Text="Придумайте код (4 цифры):" HorizontalOptions="Center" TextColor="#64748B" FontAttributes="Bold"/>
                    <Border Padding="10,0" BackgroundColor="White" Stroke="#CBD5E1" WidthRequest="200" HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Entry Text="{Binding PinCode}" Placeholder="••••" Keyboard="Numeric" MaxLength="4" 
                               HorizontalTextAlignment="Center" FontSize="36" TextColor="#1E293B" BackgroundColor="Transparent"/>
                    </Border>
                </VerticalStackLayout>

                <Button Text="Продолжить" Command="{Binding NextStepCommand}" BackgroundColor="#0EA5E9" TextColor="White" FontAttributes="Bold" CornerRadius="14" HeightRequest="56" Margin="0,20,0,0"/>
                <Button Text="Назад" Command="{Binding PreviousStepCommand}" BackgroundColor="Transparent" TextColor="#64748B" FontAttributes="Bold"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="20" IsVisible="{Binding CurrentStep, Converter={StaticResource IntToVisibleConverter}, ConverterParameter=3}">
                <Label Text="Ваш капитал" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#1E293B"/>
                <Label Text="С какой суммы мы начинаем учет?" FontSize="14" HorizontalTextAlignment="Center" TextColor="#64748B" Margin="0,-10,0,10"/>

                <Border Padding="20" BackgroundColor="White" Stroke="#10B981" StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#10B981" Opacity="0.1" Offset="0,8" Radius="20"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Текущий остаток (₽)" HorizontalOptions="Center" TextColor="#64748B" FontSize="13" FontAttributes="Bold"/>
                        <Entry Text="{Binding InitialBalance}" Placeholder="0" Keyboard="Numeric" 
                               FontSize="48" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="#10B981" BackgroundColor="Transparent"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="📁 Загрузить файл выписки" Command="{Binding UploadStatementCommand}" BackgroundColor="#F1F5F9" TextColor="#334155" FontAttributes="Bold" CornerRadius="14" HeightRequest="56" Margin="0,15,0,0"/>

                <Button Text="Готово" Command="{Binding FinishCommand}" BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" CornerRadius="14" HeightRequest="56" Margin="0,20,0,0"/>
                <Button Text="Назад" Command="{Binding PreviousStepCommand}" BackgroundColor="Transparent" TextColor="#64748B" FontAttributes="Bold"/>
            </VerticalStackLayout>

        </Grid>

        <HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" Spacing="10" Margin="0,0,0,10">
            <Ellipse WidthRequest="10" HeightRequest="10" Fill="{Binding CurrentStep, Converter={StaticResource StepToColorConverter}, ConverterParameter=0}"/>
            <Ellipse WidthRequest="10" HeightRequest="10" Fill="{Binding CurrentStep, Converter={StaticResource StepToColorConverter}, ConverterParameter=1}"/>
            <Ellipse WidthRequest="10" HeightRequest="10" Fill="{Binding CurrentStep, Converter={StaticResource StepToColorConverter}, ConverterParameter=2}"/>
            <Ellipse WidthRequest="10" HeightRequest="10" Fill="{Binding CurrentStep, Converter={StaticResource StepToColorConverter}, ConverterParameter=3}"/>
        </HorizontalStackLayout>

    </Grid>
</ContentPage>